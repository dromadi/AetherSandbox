<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application android:label="@string/sample_label" android:name=".SampleApplication">
        <activity android:name=".SampleCameraActivity" android:exported="false" />
        <activity android:name=".SampleSecondActivity" android:exported="false">
            <intent-filter><action android:name="com.aether.sample.OPEN_SECOND" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
        <activity android:name=".SampleActivity" android:exported="true">
        </activity>
        <activity-alias android:name=".DisabledLauncher" android:targetActivity=".SampleActivity" android:enabled="false" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".SampleLauncher" android:targetActivity=".SampleActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <provider android:name=".SampleInitProvider" android:authorities="com.aether.sample.init" android:exported="false" android:initOrder="100" />
        <service android:name=".SampleService" android:exported="false" />
        <receiver android:name=".SampleReceiver" android:exported="false" />
    </application>
</manifest>
