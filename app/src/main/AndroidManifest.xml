<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:allowBackup="false" android:label="AetherSandbox"
        android:icon="@drawable/ic_aether" android:theme="@style/Theme.Aether"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".core.ProxyActivity" android:exported="false"
            android:process=":virtual_process" android:launchMode="singleTask"
            android:taskAffinity="com.aether.sandbox.slot0"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />
        <activity android:name=".core.ProxyActivity1" android:exported="false" android:process=":virtual_process1" android:launchMode="singleTask" android:taskAffinity="com.aether.sandbox.slot1" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />
        <activity android:name=".core.ProxyActivity2" android:exported="false" android:process=":virtual_process2" android:launchMode="singleTask" android:taskAffinity="com.aether.sandbox.slot2" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />
        <activity android:name=".core.ProxyActivity3" android:exported="false" android:process=":virtual_process3" android:launchMode="singleTask" android:taskAffinity="com.aether.sandbox.slot3" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode" />
        <activity android:name=".core.GuestStubActivity" android:exported="false" android:process=":virtual_process" android:taskAffinity="com.aether.sandbox.slot0" />
        <activity android:name=".core.GuestStubActivity1" android:exported="false" android:process=":virtual_process1" android:taskAffinity="com.aether.sandbox.slot1" />
        <activity android:name=".core.GuestStubActivity2" android:exported="false" android:process=":virtual_process2" android:taskAffinity="com.aether.sandbox.slot2" />
        <activity android:name=".core.GuestStubActivity3" android:exported="false" android:process=":virtual_process3" android:taskAffinity="com.aether.sandbox.slot3" />
        <activity android:name=".core.RuntimeRouterActivity" android:exported="false" />
        <service android:name=".media.FloatingAssistantService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
